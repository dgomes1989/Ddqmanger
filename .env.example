# Supabase - Get these from https://supabase.com → Your Project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=ddq-documents

# Database - Get from Supabase → Settings → Database → Connection string (URI)
# Change "postgresql://" to "postgresql+asyncpg://" in the connection string
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Claude API - Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
